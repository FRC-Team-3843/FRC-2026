          {
            "title": "PID Tuning Guide",
            "x": 24,
            "y": 5,
            "width": 12,
            "height": 6,
            "type": "Text Display",
            "properties": {
              "fontSize": 12
            },
            "topic": "",
            "default_value": "P = Proportional: How hard to correct error. Start low, increase until response is fast but not oscillating.\nI = Integral: Corrects steady-state error. Usually 0 for FRC. Only add if mechanism doesn't reach setpoint.\nD = Derivative: Dampens oscillation. Add if P causes overshoot. Typical: 10-100x smaller than P."
          }
